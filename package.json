{
  "name": "aira-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AIRA — Autonomous Revenue Recovery Platform",
  "scripts": {
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "node scripts/run_command.cjs pytest",
    "test:gemini": "node scripts/run_command.cjs pytest-gemini",
    "validate:dataset": "npm run validate:dataset:backend && npm run validate:dataset:frontend",
    "validate:dataset:backend": "node scripts/run_command.cjs validate-datasets",
    "validate:dataset:frontend": "npm --prefix frontend run validate:dataset",
    "verify:backend": "node scripts/run_command.cjs verify-backend",
    "build": "npm --prefix frontend run build",
    "ci": "node scripts/run_ci.cjs"
  }
}
